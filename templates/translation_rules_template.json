  "syntax_mappings": {
    "_description": "Map source syntax patterns to target syntax",
    "_example_python2_to_python3": {
      "print x": "print(x)",
      "print >>sys.stderr, x": "print(x, file=sys.stderr)",
      "except E, e:": "except E as e:",
      "raise E, msg": "raise E(msg)",
      "exec code": "exec(code)",
      "`x`": "repr(x)",
      "<>": "!=",
      "dict.iteritems()": "dict.items()",
      "dict.iterkeys()": "dict.keys()",
      "dict.itervalues()": "dict.values()",
      "dict.has_key(k)": "k in dict",
      "xrange(n)": "range(n)",
      "raw_input()": "input()",
      "reduce(f, l)": "functools.reduce(f, l)",
      "filter(None, l)": "[x for x in l if x]",
      "map(f, l)": "[f(x) for x in l]"
    },
    "REPLACE_SOURCE_SYNTAX": "REPLACE_TARGET_SYNTAX"
  },
