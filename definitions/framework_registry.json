    "custom": {
      "framework_id": "custom",
      "name": "Custom Framework (LLM-Generated)",
      "standard": "User-defined or LLM-generated",
      "domain": "Novel or hybrid systems not covered by existing frameworks",
      "definitions_file": "architectural_definitions_custom.json",
      "template_file": "custom_node_template.json",
      "terminology": {
        "node": "component",
        "edge": "connection",
        "architecture_file": "component_architecture.json",
        "system_graph": "system_graph.json",
        "node_collection": "components",
        "edge_collection": "connections"
      },
      "node_schema": {
        "primary_type": "CustomNode",
        "id_field": "node_id",
        "name_field": "node_name",
