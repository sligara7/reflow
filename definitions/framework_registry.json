      "best_for": [
        "Hybrid systems (e.g., cyber-physical-social)",
        "Novel research domains",
        "Experimental modeling",
        "Domain-specific requirements"
      ],
      "setup_requirements": [
        "LLM researches domain literature",
        "LLM creates custom definitions file",
        "LLM generates appropriate templates",
        "User reviews and approves framework"
      ]
    }
  },
  "framework_selection_guidance": {
    "decision_tree": {
      "engineered_system": "uaf",
      "biological_system": "systems_biology",
      "social_system": "social_network",
      "ecological_system": "ecological",
      "emergent_system": "complex_adaptive",
      "novel_system": "custom"
    },
    "questions_to_ask": [
      "Is this a human-engineered system (software, hardware)?",
      "Does it involve biological components (genes, proteins, organisms)?",
      "Is it primarily a social network (people, organizations, communities)?",
      "Is it an ecological system (species, populations, ecosystems)?",
      "Does it exhibit emergent, self-organizing behavior?",
      "Is it a hybrid or novel system type?"
    ]
  },
  "cross_framework_compatibility": {
    "description": "All frameworks map to the same core abstraction (nodes + edges)",
    "core_abstraction_file": "core_abstraction.json",
    "graph_tool": "system_of_systems_graph.py",
    "universal_analysis": [
      "Graph topology (centrality, clustering, paths)",
      "Knowledge gap detection",
      "Validation (circular dependencies, orphaned nodes)",
      "Visualization (networkx-based diagrams)"
    ]
  }
