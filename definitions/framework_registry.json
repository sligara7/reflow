        "strength_field": "strength",
        "connects_to_field": "connected_agents"
      },
      "best_for": [
        "Organizational networks",
        "Social influence analysis",
        "Community detection",
        "Information diffusion",
        "Collaboration networks",
        "Market ecosystems"
      ],
      "visualization_types": [
        "Sociograms",
        "Influence diagrams",
        "Community structure graphs",
        "Temporal network evolution"
