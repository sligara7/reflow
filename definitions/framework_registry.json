{
  "metadata": {
    "description": "Registry of architectural frameworks supported by Reflow",
    "version": "1.0.0",
    "purpose": "Allow system-agnostic modeling by selecting appropriate framework during setup"
  },
  "frameworks": {
    "uaf": {
      "framework_id": "uaf",
      "name": "UAF 1.2 - Unified Architecture Framework",
      "standard": "ISO/IEC 19540-1:2022 and ISO/IEC 19540-2:2022",
      "domain": "Engineered systems (software, hardware, defense, enterprise architecture)",
      "definitions_file": "architectural_definitions_uaf.json",
      "template_file": "service_architecture_template.json",
      "terminology": {
        "node": "service",
        "edge": "interface",
        "architecture_file": "service_architecture.json",
        "system_graph": "system_of_systems_graph.json",
        "node_collection": "services",
        "edge_collection": "interfaces"
      },
      "node_schema": {
        "primary_type": "ServiceFunction",
        "id_field": "service_id",
        "name_field": "service_name",
        "type_field": "classification",
        "functions_field": "functions",
        "interfaces_field": "interfaces",
        "dependencies_field": "dependencies"
      },
      "edge_schema": {
        "primary_type": "ServiceInterface",
        "id_field": "name",
        "type_field": "interface_type",
        "direction_field": "direction",
        "protocol_field": "protocol",
        "connects_to_field": "connected_services"
      },
      "best_for": [
        "Software microservices",
        "Enterprise IT systems",
        "Defense systems (DoDAF)",
        "System-of-systems integration",
        "Hardware/software co-design"
      ],
      "visualization_types": [
        "Service dependency graph",
        "Interface contract diagrams",
        "Deployment architecture",
        "Sequence diagrams"
      ]
    },
    "systems_biology": {
      "framework_id": "systems_biology",
      "name": "Systems Biology Framework",
      "standard": "Community practice (no formal ISO standard)",
      "domain": "Biological systems (molecular to ecosystem scale)",
      "definitions_file": "architectural_definitions_biology.json",
      "template_file": "biological_component_template.json",
      "terminology": {
        "node": "component",
        "edge": "interaction",
        "architecture_file": "component_architecture.json",
        "system_graph": "biological_network.json",
        "node_collection": "components",
        "edge_collection": "interactions"
      },
      "node_schema": {
        "primary_type": "BiologicalComponent",
        "id_field": "component_id",
        "name_field": "component_name",
        "type_field": "component_type",
        "functions_field": "biological_functions",
        "interfaces_field": "interactions",
        "dependencies_field": "regulatory_dependencies"
      },
      "edge_schema": {
        "primary_type": "BiologicalInteraction",
        "id_field": "interaction_id",
        "type_field": "interaction_type",
        "direction_field": "directionality",
        "mechanism_field": "molecular_mechanism",
        "connects_to_field": "target_components"
      },
      "best_for": [
        "Gene regulatory networks",
        "Metabolic pathways",
        "Protein-protein interaction networks",
        "Cell signaling cascades",
        "Ecological food webs",
        "Population dynamics"
      ],
      "visualization_types": [
        "Regulatory network diagrams",
        "Pathway maps",
        "Food web diagrams",
        "Phylogenetic trees"
      ],
      "modeling_approaches": [
        "Boolean networks",
        "Ordinary differential equations (ODEs)",
        "Agent-based models",
        "Bayesian networks",
        "Stoichiometric models"
      ]
    },
    "social_network": {
      "framework_id": "social_network",
      "name": "Social Network Analysis (SNA)",
      "standard": "Community practice (graph theory foundation)",
      "domain": "Social systems (organizations, communities, influence networks)",
      "definitions_file": "architectural_definitions_social.json",
      "template_file": "agent_profile_template.json",
      "terminology": {
        "node": "agent",
        "edge": "relationship",
