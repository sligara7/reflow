        "connects_to_field": "target_agents"
      },
      "best_for": [
        "Economic markets",
        "Urban systems",
        "Immune system modeling",
        "Traffic flow",
        "Evolutionary systems",
        "Multi-agent simulations"
      ],
      "visualization_types": [
        "Agent interaction networks",
        "Phase space diagrams",
