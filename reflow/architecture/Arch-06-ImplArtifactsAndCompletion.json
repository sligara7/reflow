{
  "workflow_metadata": {
    "version": "0.1.0",
    "name": "Arch-06 Implementation Artifacts and Completion",
    "based_on": "architecture_workflow.json step 8–9",
    "description": "Generate implementation-ready artifacts, visuals, and operational mission artifacts; finalize for handoff to development."
  },
  "entry_conditions": {
    "from": "Arch-05",
    "artifacts": [
      "specs/machine/index.json",
      "specs/machine/service_arch/<service>/service_architecture.json",
      "specs/machine/interfaces/*"
    ]
  },
  "substeps": [
    {
      "id": "A8.1",
      "name": "API Contract Definitions",
      "per_service": true,
      "template": "api_contracts_template.json",
      "output": "specs/machine/service_arch/<service>/api_contracts.json"
    },
    {
      "id": "A8.2",
      "name": "Data Model Specifications",
      "per_service": true,
      "output": "specs/machine/service_arch/<service>/data_models.json"
    },
    {
      "id": "A8.3",
      "name": "Integration Test Specifications",
      "per_service": true,
      "output": "specs/machine/service_arch/<service>/integration_tests.json"
    },
    {
      "id": "A8.4",
      "name": "Infrastructure and Deployment",
      "per_service": true,
      "outputs": [
        "specs/machine/service_arch/<service>/infrastructure.json",
        "specs/machine/service_arch/<service>/cicd_pipeline.json",
        "specs/machine/service_arch/<service>/config_templates/"
      ]
    },
    {
      "id": "A8.5",
      "name": "Development Support Materials",
      "per_service": true,
      "outputs": [
        "specs/human/service_docs/<service>/implementation_guide.md",
        "specs/human/service_docs/<service>/stubs/",
        "specs/human/service_docs/<service>/dev_setup/"
      ]
    },
    {
      "id": "A8.6",
      "name": "Quality Assurance Framework",
      "per_service": true,
      "outputs": [
        "specs/machine/service_arch/<service>/testing_requirements.json",
        "specs/machine/service_arch/<service>/observability.json",
        "specs/machine/service_arch/<service>/compliance.json",
        "specs/human/service_docs/<service>/runbooks/"
      ]
    }
  ],
  "completion": [
    {
      "id": "C9.1",
      "name": "Directory cleanup (non-destructive)",
      "description": "Document and remove only empty/redundant temp dirs; preserve context/specs",
      "tool": "manual",
      "log": "context/process_log.md"
    },
    {
      "id": "C9.2",
      "name": "Build-ready index",
      "output": "specs/machine/build_ready_index.json"
    },
    {
      "id": "C9.3",
      "name": "Build instructions",
      "output": "specs/human/BUILD_INSTRUCTIONS.md"
    },
    {
      "id": "C9.4",
      "name": "Functional test strategy",
      "output": "specs/human/FUNCTIONAL_TEST_STRATEGY.md"
    },
    {
      "id": "C9.4.1",
      "name": "Architecture context summary for visuals",
      "output": "specs/human/ARCHITECTURE_CONTEXT_SUMMARY.md"
    },
    {
      "id": "C9.5",
      "name": "Generate Mermaid visualizations",
      "outputs": [
        "specs/human/visualizations/ARCHITECTURE_VISUALIZATION.md",
        "specs/human/visualizations/level1_architecture.mmd",
        "specs/human/visualizations/level2_architecture.mmd",
        "specs/human/visualizations/level3_architecture.mmd"
      ]
    },
    {
      "id": "C9.6",
      "name": "Operational mission artifacts",
      "outputs": [
        "specs/human/SYSTEM_MISSION_STATEMENT.md",
        "specs/human/USER_SCENARIOS.md",
        "specs/human/SUCCESS_CRITERIA.md",
        "specs/human/operational_test_scenarios/"
      ]
    },
    {
      "id": "C9.7",
      "name": "Final process log entry",
      "output": "context/process_log.md"
    }
  ],
  "iteration_paths": {
    "on_incomplete_specs": "../architecture/Arch-05-ConsistencyAndSpecVerification.json",
    "on_interface_change": "../feature_update/FU-02-ArchReengineering.json"
  },
  "artifact_routing": {
    "machine": "specs/machine/service_arch/<service>/...",
    "human": "specs/human/...",
    "context": "context/...",
    "graphs": "specs/machine/graphs/..."
  },
  "handoff": {
    "produces": [
      "specs/machine/build_ready_index.json",
      "specs/human/BUILD_INSTRUCTIONS.md",
      "specs/human/FUNCTIONAL_TEST_STRATEGY.md",
      "specs/human/ARCHITECTURE_CONTEXT_SUMMARY.md",
      "specs/human/visualizations/*",
      "specs/human/SYSTEM_MISSION_STATEMENT.md",
      "specs/human/USER_SCENARIOS.md",
      "specs/human/SUCCESS_CRITERIA.md",
      "specs/human/operational_test_scenarios/"
    ],
    "next_workflow": "../development/Dev-01-InitBootstrap.json"
  }
}