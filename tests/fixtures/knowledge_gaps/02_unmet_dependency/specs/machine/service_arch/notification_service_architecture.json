{
  "service_id": "notification_service",
  "service_name": "Notification Service",
  "version": "1.0.0",
  "description": "Sends notifications - independent service",
  "framework": "uaf",
  "service_type": "application",
  "functions": [
    {
      "function_id": "F-NOT-01",
