{
  "version": "0.1.0",
  "purpose": "Concurrency, focus resolution, and synchronization policies for parallel multi-agent execution",
  "focus_resolution": {
    "per_service_focus": "systems/<system_name>/context/focus/<service>.md",
    "fallback_global_focus": "systems/<system_name>/context/current_focus.md",
    "per_service_checkpoint": "systems/<system_name>/context/checkpoints/<service>.md",
    "fallback_global_checkpoint": "systems/<system_name>/context/context_checkpoint.md",
    "resolution_rule": "If active_service is known, use per-service files; otherwise use global files"
  },
  "synchronization": {
    "locks_dir": "systems/<system_name>/context/sync/locks/",
    "gates_file": "systems/<system_name>/context/sync/gates.json",
    "exclusive_resources": [
      {"resource": "index.json", "scope": "system", "when": ["mass service add/remove", "renaming services"], "lock_required": true},
      {"resource": "interface_registry", "scope": "system", "when": ["adding/modifying ICDs"], "lock_required": true},
      {"resource": "build_ready_index.json", "scope": "system", "when": ["finalizing architecture handoff"], "lock_required": true}
    ],
    "gate_types": [
      "icd_stable",
      "schema_ready",
      "deployment_env_ready",
      "security_policy_frozen"
    ],
    "gate_model": {
      "id": "string",
      "type": "icd_stable|schema_ready|deployment_env_ready|security_policy_frozen",
      "scope": "system|service:<name>|interface:<provider->consumer>",
      "status": "open|closed",
      "opened_by": "agent_id",
      "closed_by": "agent_id",
      "notes": "string",
      "timestamp": "ISO8601"
    },
    "lock_model": {
      "resource": "string",
      "owner": "agent_id",
      "stage": "workflow stage id",
      "reason": "short text",
      "created_at": "ISO8601",
      "ttl_minutes": 20
    },
    "progression_rule": "Agents must check gates_file for required gates and acquire locks for exclusive resources before proceeding"
  },
  "concurrency_matrix": {
    "architecture": {
      "parallel_allowed": ["A2 service_arch creation per service", "A8 per-service artifact generation"],
      "exclusive_required": ["index.json full rewrite", "ICD registry updates", "build_ready_index finalization"]
    },
    "development": {
      "parallel_allowed": ["per-service code work", "per-service tests", "per-service observability"],
      "exclusive_required": ["shared contract breaking change", "global security policy update"]
    },
    "feature_update": {
      "parallel_allowed": ["multiple unrelated feature lines"],
      "exclusive_required": ["cross-cutting changes touching shared contracts"]
    }
  }
}
